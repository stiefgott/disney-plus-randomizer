{
  "manifest_version": 3,
  "name": "Disney+ Random",
  "version": "1.0.0",
  "description": "Adds private random selection for Disney+ movies, series, titles, and episodes.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://disneyplus.com/*",
    "https://*.disneyplus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Disney+ Random",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://disneyplus.com/*",
        "https://*.disneyplus.com/*"
      ],
      "js": [
        "player-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://disneyplus.com/*",
        "https://*.disneyplus.com/*"
      ],
      "js": [
        "i18n.js",
        "random-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "random-series": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Choose a random Disney+ series"
    }
  }
}
